{
"$schema": "node_modules/wrangler/config-schema.json",
"name": "boltpay",
"compatibility_date": "2026-08-20",
// Builds public/assets/home-analytics.js (not committed) before every deploy;
// without it the home page requested a missing file (404).
"build": {
"command": "npm install --no-audit --no-fund && npm run build"
},
"observability": {
"enabled": true
},
"assets": {
"directory": "public",
"not_found_handling": "404-page"
},
// Required by `npx wrangler preview` (Workers Builds on non-production branches).
// Empty: previews use only top-level settings. https://developers.cloudflare.com/workers/previews/configuration/#wrangler-configuration-file
"previews": {}
}
