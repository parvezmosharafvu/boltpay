# Cloudflare Workers static-assets headers (picked up automatically by
# `wrangler deploy` — no code change needed).
#
# Why each header exists:
#   frame-ancestors 'none' / X-Frame-Options: DENY
#     → clickjacking protection: nobody can put the payment page or the
#       admin panel inside an invisible iframe and trick clicks.
#       If you EVER intentionally iframe the payment page on a creator's
#       site, change frame-ancestors to list that origin instead.
#   script-src / style-src keep 'unsafe-inline'
#     → every page uses inline <script>/<style> blocks by design (no build
#       step), so a strict CSP would break the site. The policy still
#       whitelists the only two CDNs scripts may load from, blocks plugins
#       (object-src 'none') and stops <base> tag hijacks (base-uri 'self').
#   connect-src
#     → pages may only talk to the site itself + Supabase (REST, Auth and
#       the Realtime websocket). Nothing else can be exfiltrated via fetch.
#   Strict-Transport-Security
#     → after one HTTPS visit, the browser refuses to speak HTTP to this
#       host for a year, so a later `http://` link or a hostile network
#       cannot downgrade a payment page. includeSubDomains covers
#       pay.* and any other host in the zone.
#       NOT using `preload`: that ships the domain into browsers'
#       hard-coded HSTS list, and removal takes months. Worth adding only
#       once every subdomain is certain to be HTTPS-only forever.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.amplitude.com https://cloudflareinsights.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
